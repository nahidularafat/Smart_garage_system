// arduino_secrets.h.example
// Copy this file to "arduino_secrets.h" and enter your real credentials.

#ifndef ARDUINO_SECRETS_H
#define ARDUINO_SECRETS_H

// ─── WiFi Credentials ──────────────────────────────────────────
#define SECRET_WIFI_SSID      "YOUR_WIFI_SSID"
#define SECRET_WIFI_PASSWORD  "YOUR_WIFI_PASSWORD"

// ─── Firebase RTDB Credentials ─────────────────────────────────
#define SECRET_DATABASE_URL   "your-project-default-rtdb.firebaseio.com"
#define SECRET_DB_SECRET      "YOUR_FIREBASE_DATABASE_SECRET"

#endif
